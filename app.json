{
  "expo": {
    "name": "Dwelis",
    "slug": "dwelis-mobile",
    "owner": "kwekuboateng",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dwelis",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dwelis.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "com.dwelis.mobile"
    },
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5DD3B6"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiBaseUrl": "https://api.dwelis.com",
      "apiBaseUrlDev": "http://localhost:4001",
      "eas": {
        "projectId": "REPLACE_WITH_NEW_EAS_PROJECT_ID"
      }
    }
  }
}
